{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/checklist/**",
              "components/content/**",
              "components/core/**",
              "components/data/**",
              "components/feedback/**",
              "components/game/**",
              "components/media/**",
              "components/navigation/**",
              "ui_kits/docs/**",
              "ui_kits/site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Cinzel|Inter|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Cinzel, Inter, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Accordion'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|tag|defaultOpen|children|className|key|ref|className|style|children)$/]",
        "message": "<Accordion> doesn't accept that prop. Declared props: title, tag, defaultOpen, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|bar|level|className|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, bar, level, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|easy|medium|hard|elite|gold|skill)$/]",
        "message": "<Badge> tone must be one of 'default' | 'easy' | 'medium' | 'hard' | 'elite' | 'gold' | 'skill'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|href|icon|flourishes|disabled|className|children|onClick|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, href, icon, flourishes, disabled, className, children, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|discord|ghost|outline)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'discord' | 'ghost' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|title|icon|children|className|key|ref|className|style|children)$/]",
        "message": "<Callout> doesn't accept that prop. Declared props: tone, title, icon, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:tip|note|warning|danger)$/]",
        "message": "<Callout> tone must be one of 'tip' | 'note' | 'warning' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChecklistItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|title|description|subSteps|meta|checked|onChange|className|key|ref|className|style|children)$/]",
        "message": "<ChecklistItem> doesn't accept that prop. Declared props: id, title, description, subSteps, meta, checked, onChange, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Column'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|align|rarityKey|key|ref|className|style|children)$/]",
        "message": "<Column> doesn't accept that prop. Declared props: key, label, align, rarityKey."
      },
      {
        "selector": "JSXOpeningElement[name.name='Column'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<Column> align must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Figure'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|caption|className|key|ref|className|style|children)$/]",
        "message": "<Figure> doesn't accept that prop. Declared props: src, alt, caption, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slot'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|icon|qty|key|ref|className|style|children)$/]",
        "message": "<Slot> doesn't accept that prop. Declared props: name, icon, qty."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|className|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='InfoBox'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|title|image|rows|footer|className|key|ref|className|style|children)$/]",
        "message": "<InfoBox> doesn't accept that prop. Declared props: kind, title, image, rows, footer, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='InventoryGrid'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|label|className|key|ref|className|style|children)$/]",
        "message": "<InventoryGrid> doesn't accept that prop. Declared props: items, label, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ItemChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|icon|qty|href|rarity|className|key|ref|className|style|children)$/]",
        "message": "<ItemChip> doesn't accept that prop. Declared props: name, icon, qty, href, rarity, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ItemChip'] > JSXAttribute[name.name='rarity'] > Literal[value!=/^(?:common|uncommon|rare|very-rare|mega-rare)$/]",
        "message": "<ItemChip> rarity must be one of 'common' | 'uncommon' | 'rare' | 'very-rare' | 'mega-rare'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|total|label|thin|showMeta|className|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value, total, label, thin, showMeta, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|value|total|children|className|key|ref|className|style|children)$/]",
        "message": "<ProgressHeader> doesn't accept that prop. Declared props: title, value, total, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|title|description|value|total|children|className|key|ref|className|style|children)$/]",
        "message": "<SectionCard> doesn't accept that prop. Declared props: label, title, description, value, total, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarCategory'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|items|key|ref|className|style|children)$/]",
        "message": "<SidebarCategory> doesn't accept that prop. Declared props: label, items."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|logoSrc|legal|className|key|ref|className|style|children)$/]",
        "message": "<SiteFooter> doesn't accept that prop. Declared props: items, logoSrc, legal, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='Step'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|body|key|ref|className|style|children)$/]",
        "message": "<Step> doesn't accept that prop. Declared props: title, body."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|icon|diamond|href|className|children|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: tone, icon, diamond, href, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|gold|blue|common|uncommon|rare|very-rare|mega-rare)$/]",
        "message": "<Tag> tone must be one of 'default' | 'gold' | 'blue' | 'common' | 'uncommon' | 'rare' | 'very-rare' | 'mega-rare'."
      },
      {
        "selector": "JSXOpeningElement[name.name='VideoEmbed'] > JSXAttribute > JSXIdentifier[name!=/^(?:youtubeId|title|caption|className|key|ref|className|style|children)$/]",
        "message": "<VideoEmbed> doesn't accept that prop. Declared props: youtubeId, title, caption, className."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
